---
interface Props {
  gallery: any;
}
const { gallery } = Astro.props;

function format(files: Record<string, any>) {
  return Object.keys(files).map((key) => ({
    src: "/" + key.split("/").slice(2).join("/"),
    alt: key.split("/")[4].split(".")[0],
  }));
}

const imgs = format(gallery);
// console.log("imgs:", imgs);
---

<section class="stack">
  <h3>Gallery</h3>

  <div class="grid col-6 auto-fill">
    {
      imgs.map((img: any) => (
        <img class="galleryImg" src={img.src} alt={img.alt} />
      ))
    }
  </div>

  <div id="galleryModal">
    <div id="backsplash"></div>
    <div id="content" class="row">
      <button id="modalPrev" class="modalPrev">
        <img
          class="icon"
          src="https://img.icons8.com/ios-filled/100/chevron-left.png"
        />
      </button>

      <div class="stack">
        <img />
        <h3 class="center"></h3>
      </div>

      <button id="modalNext" class="modalNext">
        <img
          class="icon"
          src="https://img.icons8.com/ios-filled/100/chevron-right.png"
        />
      </button>
    </div>
  </div>
  <script type="module" src="/scripts/modal.js" defer></script>
</section>

<style>
  .galleryImg {
    aspect-ratio: 1;
  }

  .galleryImg:hover {
    opacity: 0.7;
    cursor: zoom-in;
  }

  #galleryModal {
    visibility: hidden;
    position: fixed;
    inset: 0;
    width: 100dvw;
    height: 100dvh;
  }

  #galleryModal.active {
    visibility: visible;
  }

  #galleryModal > * {
    position: absolute;
    margin: auto;
    width: 100%;
    height: 100%;
  }

  #galleryModal #backsplash {
    background-color: var(--color-bg-invert);
    opacity: 0.9;
  }

  #galleryModal #content {
    inset: 0;
    width: 90%;
    height: 80%;
    justify-content: center;
  }

  #galleryModal > * > div {
    height: 100%;
  }

  #galleryModal #content button {
    border-color: var(--color-button-border-invert);
    border-width: var(--border-width-thick);
    width: 44px;
    height: 44px;
  }

  #galleryModal #content button:hover {
    background: var(--color-button-bg-hover-invert);
  }

  #galleryModal #content button img {
    filter: invert(var(--invert-on));
  }

  #galleryModal #content div img {
    width: 100%;
    height: 100%;
    object-fit: scale-down;
  }

  #galleryModal h3 {
    color: var(--color-text-invert);
  }
</style>
