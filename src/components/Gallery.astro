---
interface Props {
  gallery: any;
}
const { gallery } = Astro.props;

function format(files: Record<string, any>) {
  return Object.keys(files).map((key) => ({
    src: "/" + key.split("/").slice(2).join("/"),
    alt: key.split("/")[4].split(".")[0],
  }));
}

const imgs = format(gallery);
// console.log("imgs:", imgs);
---

<section class="stack">
  <h3>Gallery</h3>

  <div class="grid col-6 auto-fill">
    {
      imgs.map((img: any) => (
        <img class="galleryImg" src={img.src} alt={img.alt} />
      ))
    }
  </div>

  <div class="modal hide">
    <div class="backsplash"></div>
    <div class="content row">
      <button>
        <img
          class="icon"
          src="https://img.icons8.com/ios-filled/100/chevron-left.png"
        />
      </button>

      <figure class="stack">
        <img />
        <h3 class="center"></h3>
      </figure>

      <button>
        <img
          class="icon"
          src="https://img.icons8.com/ios-filled/100/chevron-right.png"
        />
      </button>
    </div>
  </div>
  <script src="../scripts/modal.js"></script>
</section>

<style>
  .galleryImg {
    aspect-ratio: 1;
  }

  .galleryImg:hover {
    opacity: 0.7;
    cursor: zoom-in;
  }
</style>
