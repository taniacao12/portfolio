---
import { projects, publications } from "../pages/index.astro";
---

<div id="heroCanvasContainer" class="canvasContainer">
  <canvas id="heroCanvas"></canvas>
  <a id="linkOverlay"></a>
</div>

<script type="module" define:vars={{ projects, publications }}>
  import { InitHeroCanvas } from "/scripts/herocanvas.js";
  InitHeroCanvas({ projects, publications });
</script>

<style>
  #heroCanvas {
    display: block;
    width: 100%;
  }

  #linkOverlay {
    position: absolute;
    display: none;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
