---
import { GetProjects, GetPublications } from "@scripts/GetContent";

const projects = GetProjects();
const publications = GetPublications();
// console.log("projects:", projects);
// console.log("publications:", publications);
---

<canvas id="heroCanvas"></canvas>
<canvas id="invertMaskCanvas"></canvas>
<a id="linkOverlay"></a>

<script type="module" define:vars={{ projects, publications }}>
  import { InitHeroCanvas } from "/scripts/HeroCanvas.js";
  InitHeroCanvas({ projects, publications });
</script>

<style>
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  #invertMaskCanvas {
    mix-blend-mode: difference;
    pointer-events: none;
    z-index: 50;
  }

  #linkOverlay {
    position: absolute;
    display: none;
    pointer-events: auto;
  }
</style>
