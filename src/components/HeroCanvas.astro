---
import { GetProjects, GetPublications } from "@scripts/script.ts";

const projects = GetProjects();
const publications = GetPublications();
// console.log("projects:", projects);
// console.log("publications:", publications);
---

<div class="heroCanvasContainer">
  <canvas id="heroCanvas"></canvas>
  <a id="linkOverlay"></a>
</div>

<script type="module" define:vars={{ projects, publications }}>
  import { InitHeroCanvas } from "/scripts/HeroCanvas.js";
  InitHeroCanvas({ projects, publications });
</script>

<style>
  .heroCanvasContainer {
    position: relative;
    display: flex;
    flex: 1 0 0;
    height: 100%;
    min-height: 0;
  }

  #heroCanvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  #linkOverlay {
    position: absolute;
    display: none;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
