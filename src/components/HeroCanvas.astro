---
import { GetProjects, GetPublications } from "@scripts/GetContent";

const projects = GetProjects();
const publications = GetPublications();
// console.log("projects:", projects);
// console.log("publications:", publications);
---

<canvas
  id="heroCanvas"
  class="relative z-0 inset-0 h-full w-full pointer-events-auto"></canvas>

<a id="linkOverlay"></a>

<script type="module" define:vars={{ projects, publications }}>
  import { InitHeroCanvas } from "/scripts/HeroCanvas.js";
  InitHeroCanvas({ projects, publications });
</script>

<style>
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  #linkOverlay {
    position: absolute;
    display: none;
    pointer-events: auto;
    z-index: 10;
  }
</style>
