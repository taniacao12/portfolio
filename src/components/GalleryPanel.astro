---
import { projects, publications } from "@scripts/works.ts";
---

<aside id="galleryPanel" class="gallery hideScroll">
  <div class="imageContainer row tight">
    <div class="images row">
      {
        publications.map((p) => (
          <a href={p.href} class="publication">
            <img src={p.coverImage} alt={p.title} class="publication" />
          </a>
        ))
      }
      {
        projects.map((p) => (
          <a href={p.href} class="project">
            <img src={p.coverImage} alt={p.title} class="project" />
          </a>
        ))
      }
    </div>
  </div>
</aside>
