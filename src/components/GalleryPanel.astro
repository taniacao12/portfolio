---
import { projects, publications } from "../pages/index.astro";
---

<div class="gallery row-tight">
  <div class="siding left">H</div>
  <div class="images stack">
    {
      publications.map((p) => (
        <img src={p.coverImage} alt={p.title} class="publication" />
      ))
    }
    {
      projects.slice(0,2).map((p) => (
        <img src={p.coverImage} alt={p.title} class="project" />
      ))
    }
  </div>
  <div class="siding right">H</div>
</div>

<style>
  .gallery {
    /* position: relative; */
    /* display: flex; */
    /* flex: 1 0 0; */
    /* height: 100%; */
    /* min-height: 0; */
    overflow-y: auto;
    overflow-x: hidden;
    background: black;
    color: white;
  }

  .gallery::-webkit-scrollbar {
    display: none;
  }

  html.dark .gallery {
    background: white;
    color: black;
  }

  .siding {
    /* display: flex; */
    width: 10%;
    /* height: 100%; */
    /* align-items: center; */
  }

  .images {
    width: 240px;
    /* max-width: 100%; */
    /* height: 100%; */
    /* min-height: 0; */
  }

  .images img {
    /* display: block; */
    /* flex: 1; */
    aspect-ratio: 9 / 6;
    width: 240px;
    /* max-width: 100%; */
    object-fit: cover;
  }

  .images img.hide {
    display: none;
  }
</style>
