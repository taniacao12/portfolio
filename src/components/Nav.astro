---
interface Props {
  siteName: string;
}
const { siteName } = Astro.props;
---

<nav class="row relaxed">
  <a href="/" class="row">
    <img src="/icons/Favicon-Black.svg" alt={siteName} class="logo" />
    <h1 id="brand">{siteName}</h1>
  </a>

  <div class="row">
    <div id="filterGroup" class="buttonGroup row tight">
      <button class="label">
        <img class="icon" src="https://img.icons8.com/ios/100/filter--v1.png" />
      </button>
      <button>Projects</button>
      <button>Publications</button>
    </div>
    <script src="../scripts/filter.js"></script>

    <button id="searchBtn">
      <img
        id="searchIcon"
        class="icon"
        src="https://img.icons8.com/ios/100/search--v1.png"
      />
    </button>
    <script src="../scripts/search.js"></script>

    <label id="themeToggle">
      <input type="checkbox" class="toggle" />
      <span class="thumb">
        <img
          class="icon"
          src="https://img.icons8.com/ios/100/sun--v3.png"
          alt="theme icon"
        />
      </span>
    </label>
    <script src="../scripts/theme.js"></script>
  </div>
</nav>

<style>
  #brand {
    line-height: 1;
    color: var(--color-text);
    transition: color var(--transition-duration);
  }

  #themeToggle {
    display: inline-flex;
    position: relative;
  }
</style>
