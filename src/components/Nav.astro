---
interface Props {
  siteName: string;
}
const { siteName } = Astro.props;
---

<nav class="row relaxed">
  <a href="/" class="row brand">
    <img src="/icons/Favicon-Black.svg" alt={siteName} class="logo" />
    <h1>{siteName}</h1>
  </a>

  <div class="row left">
    <div id="filterGroup" class="buttonGroup row tight">
      <button id="filterBtn">
        <img
          id="filterIcon"
          class="icon"
          src="https://img.icons8.com/ios/100/filter--v1.png"
        />
      </button>
      <button id="projectsBtn">Projects</button>
      <button id="publicationsBtn">Publications</button>
    </div>

    <button id="searchBtn">
      <img
        id="searchIcon"
        class="icon"
        src="https://img.icons8.com/ios/100/search--v1.png"
      />
    </button>

    <label id="themeToggle" class="inputIcon">
      <input type="checkbox" id="themeButton" class="toggle" />
      <span class="thumb">
        <img
          id="themeIcon"
          class="icon"
          src="https://img.icons8.com/ios/100/sun--v3.png"
          alt="theme icon"
        />
      </span>
    </label>
  </div>
</nav>

<style>
  #filterBtn:hover {
    background: transparent;
  }

  #filterBtn {
    cursor: auto;
  }
</style>
