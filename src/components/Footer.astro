---
interface Props {
  siteName: string;
}
const { siteName } = Astro.props;
---

<footer class="row relaxed">
  <h4 id="copyright">© 2026 {siteName} All Rights Reserved.</h4>

  <div class="row left">
    <a
      id="linkedin"
      href="https://www.linkedin.com/in/taniacao/"
      target="_blank"
      rel="noopener noreferrer"
    >
      <img class="icon" src="https://img.icons8.com/ios/100/linkedin.png" />
    </a>

    <a
      id="email"
      href="mailto:taniacao12@gmail.com"
      target="_blank"
      rel="noopener noreferrer"
    >
      <img class="icon" src="https://img.icons8.com/ios/100/new-post--v1.png" />
    </a>
  </div>
  <script is:inline src="/scripts/contact.js"></script>
</footer>

<style>
  #copyright {
    font-size: 1rem;
    line-height: 1;
  }
</style>
