---
import { siteName } from "@layouts/Base.astro";
---

<footer>
  <div class="invert-target py-2">
    © 2026 {siteName} All Rights Reserved.
  </div>

  <div>
    <a
      class="invert-target group mr-4"
      href="https://www.linkedin.com/in/taniacao/"
      target="_blank"
      rel="noopener noreferrer"
    >
      <img
        src="https://img.icons8.com/ios/100/linkedin.png"
        alt="LinkedIn"
        class="icon block group-hover:hidden"
      />
      <img
        src="https://img.icons8.com/ios-filled/100/linkedin.png"
        alt="LinkedIn"
        class="icon hidden group-hover:block"
      />
    </a>

    <a
      class="invert-target group"
      href="mailto:taniacao12@gmail.com"
      target="_blank"
      rel="noopener noreferrer"
    >
      <img
        src="https://img.icons8.com/ios/100/new-post--v1.png"
        alt="Email"
        class="icon block group-hover:hidden"
      />
      <img
        src="https://img.icons8.com/ios-filled/100/new-post.png"
        alt="Email"
        class="icon hidden group-hover:block"
      />
    </a>
  </div>
</footer>
