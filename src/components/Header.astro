---
interface Props {
  coverImage: string;
  coverImageAlt: string;
  title: string;
  subtitle: string;
}
const { coverImage, coverImageAlt, title, subtitle } = Astro.props;
---

<header class="stack tight">
  <img src={coverImage} alt={coverImageAlt} />

  <div>
    <h1>{title}</h1>
    <h2>{subtitle}</h2>
  </div>
</header>
