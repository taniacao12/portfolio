---
import { siteName } from "@layouts/Base.astro";
---

<nav>
  <a href="/" class="brand row">
    <img src="/Favicon Black.svg" alt={siteName} class="logo" />
    {siteName}
  </a>

  <div class="row">
    <div class="buttonGroup row-tight">
      <button id="projectsBtn">Projects</button>
      <button id="publicationsBtn">Publications</button>
    </div>
    <script src="@scripts/filter.ts"></script>

    <label class="inputIcon">
      <input type="checkbox" id="themeToggle" class="toggle" />
      <span class="thumb">
        <img
          id="themeIcon"
          class="icon invert"
          src="https://img.icons8.com/ios/100/sun--v3.png"
          alt="theme icon"
        />
      </span>
    </label>
    <script src="@scripts/theme.ts"></script>
  </div>
</nav>
