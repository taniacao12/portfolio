---
import { siteName } from "@layouts/Base.astro";
---

<nav>
  <a href="/" class="brand row">
    <img src="/favicon.svg" alt={siteName} class="logo invert" />
    {siteName}
  </a>

  <div class="row">
    <div class="buttonGroup row-tight">
      <button id="projectsBtn">Projects</button>
      <button id="publicationsBtn">Publications</button>
    </div>
    <button id="galleryBtn">
      <img class="icon" src="https://img.icons8.com/ios/100/movie--v1.png" />
    </button>
  </div>
</nav>

<script>
  window.filterMode = {
    projects: false,
    publications: false,
  };
  window.heroTransitionStart = false;

  const projectsBtn = document.getElementById(
    "projectsBtn",
  )! as HTMLButtonElement;
  const publicationsBtn = document.getElementById(
    "publicationsBtn",
  )! as HTMLButtonElement;
  const galleryBtn = document.getElementById(
    "galleryBtn",
  )! as HTMLButtonElement;

  if (!projectsBtn || !publicationsBtn) {
    console.error("Filter buttons not found in DOM");
  } else {
    function toggle(btn: HTMLButtonElement, key: "projects" | "publications") {
      const isActive = btn.classList.contains("active");

      // update filter state
      window.filterMode[key] = !isActive;
      btn.classList.toggle("active");

      // always read fresh filter state
      const fm = window.filterMode;
      const images = document.querySelectorAll(".images img");

      images.forEach((img) => {
        const isProject = img.classList.contains("project");
        const isPublication = img.classList.contains("publication");

        const hide =
          (fm.projects || fm.publications) &&
          !((fm.projects && isProject) || (fm.publications && isPublication));

        img.classList.toggle("hide", hide);
      });
    }

    projectsBtn.addEventListener("click", () => {
      if (window.location.pathname !== "/") {
        window.location.href = "/?filter=projects";
      } else {
        toggle(projectsBtn, "projects");
      }
    });

    publicationsBtn.addEventListener("click", () => {
      if (window.location.pathname !== "/") {
        window.location.href = "/?filter=publications";
      } else {
        toggle(publicationsBtn, "publications");
      }
    });

    galleryBtn.addEventListener("click", () => {
      galleryBtn.classList.toggle("active");
      galleryBtn.querySelector("img")!.classList.toggle("invert");
      const gallery = document.getElementById("galleryPanel");
      gallery?.classList.toggle("active");
      window.heroTransitionStart = true;
    });
  }
</script>
