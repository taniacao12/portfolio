---
import { siteName } from "@layouts/Base.astro";
---

<nav>
  <div>
    <a href="/" class="invert-target">
      <img src="/favicon.ico" alt={siteName} class="h-8 w-8 mr-3" />
      {siteName}
    </a>
  </div>

  <div>
    <button id="projectsBtn" class="invert-target mr-4"> Projects </button>
    <button id="publicationsBtn" class="invert-target"> Publications </button>
  </div>
</nav>

<script>
  // @ts-ignore
  window.filterMode = {
    projects: false,
    publications: false,
  };

  const projectsBtn = document.getElementById(
    "projectsBtn",
  )! as HTMLButtonElement;
  const publicationsBtn = document.getElementById(
    "publicationsBtn",
  )! as HTMLButtonElement;

  if (!projectsBtn || !publicationsBtn) {
    console.error("Filter buttons not found in DOM");
  } else {
    function toggle(btn: HTMLButtonElement, key: "projects" | "publications") {
      const isActive = btn.classList.contains("active");

      if (isActive) {
        btn.classList.remove("active");
        // @ts-ignore
        window.filterMode[key] = false;
      } else {
        btn.classList.add("active");
        // @ts-ignore
        window.filterMode[key] = true;
      }
    }

    projectsBtn.addEventListener("click", () => {
      if (window.location.pathname !== "/") {
        window.location.href = "/?filter=projects";
      } else {
        toggle(projectsBtn, "projects");
      }
    });

    publicationsBtn.addEventListener("click", () => {
      if (window.location.pathname !== "/") {
        window.location.href = "/?filter=publications";
      } else {
        toggle(publicationsBtn, "publications");
      }
    });
  }
</script>

<style>
  a {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    text-decoration: none;
    cursor: pointer;
  }
  button {
    cursor: pointer;
    text-transform: uppercase;
    font-size: 1rem;
  }
  button:hover {
    border: 2px solid black;
  }
  .active {
    color: white;
    background-color: black;
  }
</style>
