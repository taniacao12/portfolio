---
import { getWorks } from "@scripts/script.ts";
import Base from "@layouts/Base.astro";
import Header from "@components/Header.astro";
import Gallery from "@components/Gallery.astro";

interface Props {
  title: string;
  subtitle: string;
  description: string;
  coverImage: string;
  coverImageAlt: string;
  course: string;
  courseDescription: string;
  advisor: string;
  collaborators: string;
  date: string;
  location: string;
  gallery: any;
}
const {
  title,
  subtitle,
  description,
  coverImage,
  coverImageAlt,
  course,
  courseDescription,
  advisor,
  collaborators,
  date,
  location,
  gallery,
} = Astro.props;

function join(a: string, b: string) {
  return b ? `${a}: ${b}` : a;
}

const wrap = (i: number, len: number) => (i + len) % len;

const info = [
  { label: "Course", text: join(course, courseDescription) },
  { label: "Advisor", text: advisor },
  { label: "Collaborator", text: collaborators },
  { label: "Date", text: date },
  { label: "Location", text: location },
].filter((i) => i.text);

const works = [...getWorks()];
const index = works.findIndex((w) => w.title === title);
const prevWork = works[wrap(index - 1, works.length)];
const nextWork = works[wrap(index + 1, works.length)];
// console.log("works:", works);
---

<Base
  title={title}
  description={description}
  coverImage={coverImage}
  coverImageAlt={coverImageAlt}
>
  <article class="stack relaxed">
    <Header
      coverImage={coverImage}
      coverImageAlt={coverImageAlt}
      title={title}
      subtitle={subtitle}
    />

    <div id="properties" class="grid col-3 relaxed">
      {
        info.map((item) => (
          <div class="stack tight">
            <h3>{item.label} \</h3>
            <p>{item.text}</p>
          </div>
        ))
      }
    </div>

    <hr />
    <slot />

    <hr />
    <Gallery gallery={gallery} />

    <hr />
    <div id="navButtons" class="row">
      {
        prevWork && (
          <a href={prevWork.href}>
            <div class="buttonGroup row tight">
              <button class="label">
                <img
                  class="icon"
                  src="https://img.icons8.com/ios-filled/100/chevron-left.png"
                />
              </button>
              <button>{prevWork.title}</button>
            </div>
          </a>
        )
      }

      <button id="scrollBtn">Back To Top</button>
      <script type="module">
        const scrollBtn = document.getElementById("scrollBtn");

        scrollBtn.addEventListener("click", () => {
          document.documentElement.scrollTo({ top: 0, behavior: "smooth" });
        });
      </script>

      {
        nextWork && (
          <a href={nextWork.href}>
            <div class="buttonGroup row tight">
              <button>{nextWork.title}</button>
              <button class="label">
                <img
                  class="icon"
                  src="https://img.icons8.com/ios-filled/100/chevron-right.png"
                />
              </button>
            </div>
          </a>
        )
      }
    </div>

    <hr />
  </article>
</Base>

<script type="module">
  document.documentElement.classList.toggle("stable-scrollbar");
</script>

<style>
  #navButtons {
    justify-content: space-between;
  }
</style>
