---
import Base from "@layouts/Base.astro";

interface Props {
  title: string;
  subtitle: string;
  description: string;
  coverImage: string;
  coverImageAlt: string;
  course: string;
  courseDescription: string;
  instructor: string;
  collaborators: string;
  date: string;
  location: string;
}
const props = Astro.props;
---

<Base
  title={props.title}
  description={props.description}
  coverImage={props.coverImage}
  coverImageAlt={props.coverImageAlt}
>
  <header>
    <img
      src={props.coverImage}
      alt={props.coverImageAlt}
      class="rounded-lg object-cover object-center"
    />

    <div class="header">
      <h1>{props.title}</h1>
      <h2>{props.subtitle}</h2>
    </div>
  </header>

  <article>
    <aside>
      {
        props.course && (
          <>
            <h3>Course \</h3>
            <p>
              {props.course}: {props.courseDescription}
            </p>
          </>
        )
      }

      {
        props.instructor && (
          <>
            <h3>Instructor \</h3>
            <p>{props.instructor}</p>
          </>
        )
      }

      {
        props.collaborators && (
          <>
            <h3>Collaborators \</h3>
            <p>{props.collaborators}</p>
          </>
        )
      }

      {
        props.date && (
          <>
            <h3>Date \</h3>
            <p>{props.date}</p>
          </>
        )
      }

      {
        props.location && (
          <>
            <h3>Location \</h3>
            <p>{props.location}</p>
          </>
        )
      }
    </aside>

    <slot />
  </article>
</Base>
