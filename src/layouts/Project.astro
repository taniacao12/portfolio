---
import Base from "@layouts/Base.astro";

interface Props {
  title: string;
  subtitle: string;
  description: string;
  coverImage: string;
  coverImageAlt: string;
  course: string;
  courseDescription: string;
  instructor: string;
  collaborators: string;
  date: string;
  location: string;
}
const props = Astro.props;
---

<Base
  title={props.title}
  description={props.description}
  coverImage={props.coverImage}
  coverImageAlt={props.coverImageAlt}
>
  <div
    class="mx-auto max-w-5xl items-center justify-between p-4 pointer-events-auto"
  >
    <div>
      <img
        src={props.coverImage}
        alt={props.coverImageAlt}
        class="rounded-lg object-cover object-center"
      />
    </div>
    <br />
    <br />
    <div class="flex justify-between items-start w-full">
      <div class="flex-7 flex-col">
        <h1>{props.title}</h1>
        <h2>{props.subtitle}</h2>
        <br />

        <div set:html={props.description} />
      </div>

      <div class="flex-3 text-right">
        <p>Course \<br />{props.course}:<br />{props.courseDescription}</p>
        <br />
        <p>Instructor \<br />{props.instructor}</p>
        <br />
        <p>Collaborators \<br />{props.collaborators}</p>
        <br />
        <p>Date \<br />{props.date}</p>
        <br />
        <p>Location \<br />{props.location}</p>
      </div>
    </div>
    <br />

    <slot />
  </div>
</Base>
