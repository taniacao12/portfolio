---
import "../styles/global.css";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";

interface Props {
  title: string;
  subtitle: string;
  coverImage: string;
  coverImageAlt: string;
  course: string;
  courseDescription: string;
  instructor: string;
  collaborators: string;
  date: string;
  location: string;
  description: string;
}
const { title, subtitle, coverImage, coverImageAlt, description } = Astro.props;
const author = "Tania Cao";
const siteName = `${author}.`;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="https://use.typekit.net/lrv4mja.css" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | {siteName}</title>

    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta name="author" content={author} />
    <meta property="og:title" content={`${title} | ${siteName}`} />
    <meta property="og:description" content={`${subtitle}<br />${description}`} />
    <meta property="og:image" content={coverImage} />
    <meta property="og:image:alt" content={coverImageAlt} />
  </head>

  <body class="flex min-h-screen flex-col">
    <Header />

    <main class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
