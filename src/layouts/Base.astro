---
import "@styles/global.css";
import "@styles/misc.css";
import Nav from "@components/Nav.astro";
import Directory from "@components/Directory.astro";
import Footer from "@components/Footer.astro";

interface Props {
  title: string;
  description: string;
  coverImage: string;
  coverImageAlt: string;
}
const { title, description, coverImage, coverImageAlt } = Astro.props;
const author = "Tania Cao";
const siteName = `${author}.`;
---

<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" type="image/svg+xml" href="/icons/Favicon-Black.svg" />
    <link rel="icon" href="/icons/Favicon-Black.ico" />
    <link rel="stylesheet" href="https://use.typekit.net/lrv4mja.css" />

    <title>{title} | {siteName}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="canonical" href="https://taniacao.vercel.app/" />

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} | ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={coverImage} />
    <meta property="og:image:alt" content={coverImageAlt} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${siteName}`} />
    <meta name="twitter:description" content={description} />

    <script src="/scripts/setup.js" is:inline></script>
  </head>

  <body class="stack tight">
    <script src="../scripts/setup.js"></script>

    <Nav siteName={siteName} />

    <main class="stack stretch tight">
      <Directory />

      <slot />
      <script src="../scripts/grid.js"></script>
    </main>

    <Footer siteName={siteName} />
  </body>
</html>
