---
import Base from "@layouts/Base.astro";

interface Props {
  title: string;
  subtitle: string;
  description: string;
  coverImage: string;
  coverImageAlt: string;
  date: string;
}
const props = Astro.props;
---

<Base
  title={props.title}
  description={props.description}
  coverImage={props.coverImage}
  coverImageAlt={props.coverImageAlt}
>
  <header>
    <h1>{props.title}</h1>
    <h2>{props.subtitle}</h2>
  </header>

  <article>
    <aside>
      <h3>Date \</h3>
      <p>{props.date}</p>
    </aside>

    <slot />
  </article>
</Base>
