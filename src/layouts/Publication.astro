---
import Base from "@layouts/Base.astro";

interface Props {
  title: string;
  subtitle: string;
  description: string;
  coverImage: string;
  coverImageAlt: string;
  date: string;
}
const props = Astro.props;
---

<Base
  title={props.title}
  description={props.description}
  coverImage={props.coverImage}
  coverImageAlt={props.coverImageAlt}
>
  <div
    class="mx-auto max-w-5xl items-center justify-between p-4 pointer-events-auto"
  >
    <div class="flex justify-between items-start w-full">
      <div class="flex-7 flex-col">
        <h1>{props.title}</h1>
        <h2>{props.subtitle}</h2>
        <br />

        <div set:html={props.description} />
      </div>

      <div class="flex-3 text-right">
        <p>Date \</p>
        <p>{props.date}</p>
      </div>
    </div>
    <br />

    <slot />
  </div>
</Base>
