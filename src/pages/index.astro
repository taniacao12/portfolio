---
import Base from "@layouts/Base.astro";
import HeroCanvas from "@components/HeroCanvas.astro";

type ProjectModule = {
	frontmatter: { coverImage: string };
};
type PublicationModule = {
	frontmatter: { coverImage: string };
};

const projectFiles = import.meta.glob<ProjectModule>(
	"/src/pages/projects/*.astro",
	{ eager: true },
);
const publicationFiles = import.meta.glob<PublicationModule>(
	"/src/pages/publications/*.astro",
	{ eager: true },
);
// console.log("projectFiles:", Object.keys(projectFiles));
// console.log("publicationFiles:", Object.keys(publicationFiles));

const projects = Object.entries(projectFiles).map(([path, mod]) => ({
	href: path.replace("/src/pages", "").replace(".astro", ""),
	coverImage: mod.frontmatter.coverImage,
}));
const publications = Object.entries(publicationFiles).map(([path, mod]) => ({
	href: path.replace("/src/pages", "").replace(".astro", ""),
	coverImage: mod.frontmatter.coverImage,
}));
// console.log("projects:", projects);
// console.log("publications:", publications);
---

<Base
	title="Portfolio"
	subtitle="A series of selected works by Tania Cao."
	description=""
	coverImage={"/favicon.png"}
	coverImageAlt={"Tania Cao."}
	course=""
	courseDescription=""
	instructor=""
	collaborators=""
	date=""
	location=""
>
	<HeroCanvas projects={projects} publications={publications} />
</Base>

<script>
	const params = new URLSearchParams(window.location.search);
	const filter = params.get("filter");

	if (filter === "projects") {
		// @ts-ignore
		window.filterMode.projects = true;
		document.getElementById("projectsBtn")?.classList.add("nav-active");
	}

	if (filter === "publications") {
		// @ts-ignore
		window.filterMode.publications = true;
		document.getElementById("publicationsBtn")?.classList.add("nav-active");
	}

	history.replaceState({}, "", "/");
</script>
