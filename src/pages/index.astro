---
import Base from "@layouts/Base.astro";
import HeroCanvas from "@components/HeroCanvas.astro";
import GalleryPanel from "@components/GalleryPanel.astro";
---

<Base
	title="Portfolio"
	description="A series of selected works by Tania Cao."
	coverImage="/favicon.ico"
	coverImageAlt="Tania Cao."
>
	<section class="heroLayout">
		<HeroCanvas />
		<aside id="galleryPanel">
			<GalleryPanel />
		</aside>
	</section>

	<script>
		const params = new URLSearchParams(window.location.search);
		const filter = params.get("filter");

		if (filter === "projects") {
			window.filterMode.projects = true;
			document.getElementById("projectsBtn")?.classList.add("active");
		}

		if (filter === "publications") {
			window.filterMode.publications = true;
			document.getElementById("publicationsBtn")?.classList.add("active");
		}

		history.replaceState({}, "", "/");
	</script>
</Base>
