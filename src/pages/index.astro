---
import { projects, publications } from "@scripts/works.ts";
import Base from "@layouts/Base.astro";
---

<Base
	title="Portfolio"
	description="A series of selected works by Tania Cao."
	coverImage="/favicon.ico"
	coverImageAlt="Tania Cao."
>
	<div id="heroCanvasContainer" class="canvasContainer">
		<canvas id="heroCanvas"></canvas>
		<a id="linkOverlay"></a>
	</div>

	<script type="module" define:vars={{ projects, publications }}>
		import { InitHeroCanvas } from "/scripts/herocanvas.js";
		InitHeroCanvas({ projects, publications });
	</script>

	<style>
		#heroCanvas {
			display: block;
			width: 100%;
		}

		#linkOverlay {
			position: absolute;
			display: none;
			inset: 0;
			width: 100%;
			height: 100%;
			pointer-events: none;
		}
	</style>
</Base>

<style>
	html {
		overflow-y: hidden;
	}

	html::-webkit-scrollbar:vertical {
		display: none;
	}
</style>
