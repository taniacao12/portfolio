---
import { GetProjects, GetPublications } from "@scripts/script.ts";
import Base from "@layouts/Base.astro";
import HeroCanvas from "@components/HeroCanvas.astro";
import GalleryPanel from "@components/GalleryPanel.astro";

export const projects = GetProjects();
export const publications = GetPublications();
// console.log("projects:", projects);
// console.log("publications:", publications);
---

<Base
	title="Portfolio"
	description="A series of selected works by Tania Cao."
	coverImage="/favicon.ico"
	coverImageAlt="Tania Cao."
>
	<section class="mainSection">
		<HeroCanvas />

		<aside id="galleryPanel">
			<GalleryPanel />
		</aside>
		<script>
			const heroCanvasContainer = document.getElementById(
				"heroCanvasContainer",
			)! as HTMLElement;
			const aside = document.getElementById(
				"galleryPanel",
			)! as HTMLElement;

			aside.addEventListener("transitionend", () => {
				heroCanvasContainer.classList.toggle("active");
			});

			window.debug("gallery panel loaded");
		</script>
	</section>
</Base>

<script>
	window.debug("base loaded");
</script>
