---
import { getWorks } from "@scripts/script.ts";
import Base from "@layouts/Base.astro";

const works = getWorks();
// console.log("works:", works);
---

<Base
	title="Portfolio"
	description="A series of selected works by Tania Cao."
	coverImage="/favicon.ico"
	coverImageAlt="Tania Cao."
>
	<div id="canvasContainer" class="stretch canvasContainer">
		<canvas></canvas>
		<a></a>
	</div>
</Base>

<script type="module" define:vars={{ works }}>
	import { setMinBodyHeight } from "/scripts/utils.js";
	import { InitHeroCanvas } from "/scripts/herocanvas.js";

	setMinBodyHeight();
	window.addEventListener("resize", setMinBodyHeight);

	InitHeroCanvas({ works });
</script>

<style>
	.canvasContainer {
		position: relative;
		display: flex;
		flex: 1 0 0;
		height: 100%;
	}

	.canvasContainer canvas {
		width: 100%;
	}

	.canvasContainer a {
		position: absolute;
		display: none;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}
</style>
