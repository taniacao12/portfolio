---
import { getWorks } from "@scripts/script.ts";
import Base from "@layouts/Base.astro";

const works = getWorks();
// console.log("works:", works);
---

<Base
	title="Portfolio"
	description="A series of selected works by Tania Cao."
	coverImage="/favicon.ico"
	coverImageAlt="Tania Cao."
>
	<div id="heroCanvas">
		<canvas></canvas>
		<a class="hide"></a>
	</div>
	<script type="module" define:vars={{ works }}>
		import { InitHeroCanvas } from "/scripts/herocanvas.js";
		InitHeroCanvas({ works });
	</script>
</Base>

<style>
	#heroCanvas {
		display: flex;
		position: relative;
		flex: 1 0 0;
		height: auto;
	}

	#heroCanvas a {
		position: absolute;
		inset: 0;
		pointer-events: auto;
	}

	#heroCanvas a.hide {
		display: none;
		pointer-events: none;
	}
</style>
