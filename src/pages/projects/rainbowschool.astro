</Project>

<script>
    let slideIndex = 0;
    showSlides();

    function showSlides() {
        let i;
        let slides = document.getElementsByClassName("slide");
        for (i = 0; i < slides.length; i++) {
            // @ts-ignore
            slides[i].style.display = "none";
        }
        slideIndex++;
        if (slideIndex > slides.length) {
            slideIndex = 1;
        }
        // @ts-ignore
        slides[slideIndex - 1].style.display = "block";
        setTimeout(showSlides, 4000);
    }
</script>
