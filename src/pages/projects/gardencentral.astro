---
import Work from "@layouts/Work.astro";

export const frontmatter = {
    title: "Garden Central",
    date: "2021.05.03",
    coverImage: "/gardencentral/Eye Level Night.jpg",
};
---

<Work
    title={frontmatter.title}
    subtitle="Architecture as a Scaffold for Everyday Rituals"
    description=""
    coverImage={frontmatter.coverImage}
    coverImageAlt={frontmatter.title}
    course="Architectural Studio IV"
    courseDescription="Mixed-Use Housing"
    advisor="Adam Dayem"
    collaborators="Yi Liu"
    date={frontmatter.date}
    location="Troy, New York"
    gallery={import.meta.glob("/public/gardencentral/gallery/*")}
>
    <section class="stack">
        <p>
            Set within the historic shell of St. Mary's Church, this adaptive
            reuse project blurs the boundaries between residence and commerce. A
            large plaza welcomes visitors with park-like features, anchoring a
            spatial sequence that unfolds across four distinct programs: a
            ground-floor gathering space for markets and concerts, basement
            workshops for artists and lecturers, upper-level galleries for
            public art, and a rooftop garden for cultivation and community.
        </p>
        <p>
            Designed to foster a self-sustaining ecosystem, the building invites
            low-income residents to live, work, and play within a shared
            environment. Circulation weaves vertically through the core, echoing
            the branching complexity of nature and encouraging interaction
            across levels. Apartment units integrate old and new structures,
            balancing privacy with access to communal courtyards and shared
            spaces. The architecture becomes a framework for unity—where talent,
            greenery, and public life converge.
        </p>
        <img src="/gardencentral/Exploded Axon.jpg" alt="Exploded Axon" />
        <img src="/gardencentral/Unit Drawings.jpg" alt="Unit Drawings" />
        <img src="/gardencentral/Plans & Section.jpg" alt="Plans & Section" />
    </section>
</Work>
